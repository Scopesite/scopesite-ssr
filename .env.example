# Brevo website tracker (Marketing Automation > Settings > Tracking code)
NEXT_PUBLIC_BREVO_CLIENT_KEY=

# Ahrefs Web Analytics
# Required in Production and Preview environments on Vercel.
# The NEXT_PUBLIC_ prefix is mandatory because the script runs client-side.
# Obtain the key from your Ahrefs Web Analytics project settings.
NEXT_PUBLIC_AHREFS_ANALYTICS_KEY=

# Google Analytics 4 (Measurement ID from GA4 > Admin > Data streams)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
